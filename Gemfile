source "https://rubygems.org"

# The same Jekyll that GitHub Actions (.github/workflows/pages.yml) uses to build the site.
gem "jekyll", "~> 4.4"
gem "kramdown-parser-gfm"   # GitHub-flavoured Markdown (tables, fenced code) — see kramdown.input in _config.yml
gem "webrick"               # needed by `jekyll serve` on Ruby >= 3
